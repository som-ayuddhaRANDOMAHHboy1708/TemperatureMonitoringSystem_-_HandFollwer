able(\"C D F E G A C5 B \", 120),\n            music.PlaybackMode.UNTIL_DONE)\n        OLED12864_I2C.show_string(6, 2, \"INTERMEDIATE\", 1)\nbasic.forever(on_forever2)\n"}]},{"timestamp":1786718741687,"editorVersion":"9.0.8","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":8924,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"u}O2fpYE~Cm4[c.`y,Gd\">IR</variable><variable id=\"$z9#Zc~:b0;Tr|:)%B$b\">Temperature</variable></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"OLED12864_I2C_init\"><value name=\"addr\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value></block></statement></block><block type=\"device_forever\" x=\"-3\" y=\"143\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"u}O2fpYE~Cm4[c.`y,Gd\">IR</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"device_get_digital_pin\"><value name=\"name\"><shadow type=\"digital_pin_shadow\"><field name=\"pin\">DigitalPin.P0</field></shadow></value></block></value><next><block type=\"OLED12864_I2C_NUMBER\"><value name=\"x\"><shadow type=\"math_number\"><field name=\"NUM\">5</field></shadow></value><value name=\"y\"><shadow type=\"math_number\"><field name=\"NUM\">5</field></shadow></value><value name=\"num\"><shadow type=\"math_number\"><field name=\"NUM\">12</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"u}O2fpYE~Cm4[c.`y,Gd\">IR</field></block></value><value name=\"color\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value><next><block type=\"controls_if\"><mutation elseif=\"1\"></mutation><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"logic_compare\"><field name=\"OP\">EQ</field><value name=\"A\"><shadow type=\"math_number\" disabled-reasons=\"pxt_automatic_disabl